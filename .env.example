# Copy to .env and fill in your values. Never commit .env.

# ESXi host reachable over SSH from the panel server
ESXI_HOST=192.168.1.10
ESXI_PORT=22
ESXI_USER=root

# Quote the password if it contains # or special characters
ESXI_PASSWORD="change-me"

# Panel listen address (inside the container use 0.0.0.0)
APP_HOST=0.0.0.0
APP_PORT=8080
